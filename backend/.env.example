# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# MongoDB Atlas Connection String
# Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/trade_knowledge_db?retryWrites=true&w=majority

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Optional seed operator values; set both to create or update an admin account.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=choose_a_unique_password_at_least_10_chars
